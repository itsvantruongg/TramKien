<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission
        android:name="android.permission.INTERNET"/>
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission
        android:name="android.permission.WAKE_LOCK"/>
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <application
        android:label="Trạm Kiến"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="tramkien" android:host="schedule" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action
                    android:name="android.intent.action.BOOT_COMPLETED"/>
                <action
                    android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action
                    android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action
                    android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- thêm receiver này -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>

        <!-- ==================== 4 WIDGET CHUẨN SPEC MỚI ==================== -->
        <!-- AppWidget 1: Hôm nay (2x2) -->
        <receiver
            android:name=".SingleDay2x2ScheduleWidgetProvider"
            android:exported="true"
            android:label="Lịch hôm nay">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.tramkien.hau.ACTION_UPDATE_WIDGET" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_schedule_single_day_2x2_info" />
        </receiver>

        <!-- AppWidget 2: Tháng + Hôm nay (4x2) -->
        <receiver
            android:name=".MonthToday4x2ScheduleWidgetProvider"
            android:exported="true"
            android:label="Lịch tháng">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.tramkien.hau.ACTION_UPDATE_WIDGET" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_schedule_month_today_4x2_info" />
        </receiver>

        <!-- AppWidget 3: Lịch 3 Ngày Tới (4x2) -->
        <receiver
            android:name=".ThreeDaysScheduleWidgetProvider"
            android:exported="true"
            android:label="Lịch 3 ngày">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.tramkien.hau.ACTION_UPDATE_WIDGET" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_schedule_three_days_info" />
        </receiver>

        <!-- AppWidget 4: Lịch Tuần Toàn Cảnh 8 Ô (4x4) -->
        <receiver
            android:name=".WeeklyScheduleWidgetProvider"
            android:exported="true"
            android:label="Lịch tuần">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.tramkien.hau.ACTION_UPDATE_WIDGET" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_schedule_weekly_info" />
        </receiver>

        <!-- Service RemoteViews cho ListView Widget Tuần 4x4 -->
        <service
            android:name=".WeeklyRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Receiver thời gian và boot dùng chung cho toàn bộ Widget (SPEC-DYNAMIC-SQLITE-WIDGET-SYSTEM-01) -->
        <receiver
            android:name=".WidgetTimeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ==================== RECEIVERS LEGACY (DISABLED) ==================== -->
        <!-- AppWidget Option 1: 4x2 Lịch Hôm Nay (Timeline Legacy) -->
        <receiver
            android:name=".SingleDayScheduleWidgetProvider"
            android:exported="true"
            android:enabled="false"
            android:label="Lịch hôm nay">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.tramkien.hau.ACTION_UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_schedule_single_day_info" />
        </receiver>

        <!-- AppWidget Option 4: 4x2 Weekly Strip Calendar (Legacy) -->
        <receiver
            android:name=".WeeklyStripScheduleWidgetProvider"
            android:exported="true"
            android:enabled="false"
            android:label="Lịch 7 ngày">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.tramkien.hau.ACTION_UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_schedule_weekly_strip_info" />
        </receiver>

        <!-- AppWidget Option 6: 4x2 Lịch Ngày Mai (Legacy) -->
        <receiver
            android:name=".TomorrowScheduleWidgetProvider"
            android:exported="true"
            android:enabled="false"
            android:label="Lịch ngày mai">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.tramkien.hau.ACTION_UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_schedule_tomorrow_info" />
        </receiver>

        <!-- Receiver nhận callback khi người dùng bấm "Thêm tự động" trên hộp thoại Launcher -->
        <receiver
            android:name=".WidgetPinSuccessReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.tramkien.hau.ACTION_PIN_WIDGET_SUCCESS" />
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action
                android:name="android.intent.action.PROCESS_TEXT"/>
            <data
                android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action
                android:name="android.intent.action.SENDTO"/>
            <data
                android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>