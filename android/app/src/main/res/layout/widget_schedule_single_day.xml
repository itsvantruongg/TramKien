<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC-TIMELINE-WIDGET-01: 4x2 Single Day Minimal Timeline Layout -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    android:background="@android:color/transparent">

    <FrameLayout
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

    <!-- Header: Title + Subtitle -->
    <LinearLayout
        android:id="@+id/widget_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Hidden Accent Bar -->
        <ImageView
            android:id="@+id/widget_accent_bar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lịch hôm nay"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thứ Hai, 26/10"
            android:textColor="#98989D"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Hairline Divider 0.5dp -->
    <ImageView
        android:id="@+id/widget_hairline"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#33FFFFFF" />

    <!-- Schedule Content Container -->
    <LinearLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="top">

        <!-- Active Classes Timeline Container -->
        <LinearLayout
            android:id="@+id/single_day_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="top">

            <!-- Ca 1: Timeline Row (Cột trái: Giờ bắt đầu + Trục timeline capsule; Cột phải: Tên + Hàng phụ trợ) -->
            <LinearLayout
                android:id="@+id/class_item_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="2dp">

                <!-- Cột trái: Giờ bắt đầu & Giờ kết thúc -->
                <LinearLayout
                    android:layout_width="46dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="start|center_vertical">

                    <TextView
                        android:id="@+id/single_class_1_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:text="7h"
                        android:textColor="#1D64F2"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"
                        android:includeFontPadding="false"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/single_class_1_time_end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:text="- 9h20"
                        android:textColor="#98989D"
                        android:textSize="9.5sp"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="-0.02"
                        android:includeFontPadding="false"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Trục Timeline Indicator (Capsule / Line màu Accent) -->
                <ImageView
                    android:id="@+id/single_class_1_indicator"
                    android:layout_width="3dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="10dp"
                    android:background="#1D64F2" />

                <!-- Cột phải: 2 dòng (Dòng 1: Tên môn; Dòng 2: Phụ trợ trên đúng 1 hàng) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Dòng 1: Tên môn học to rõ -->
                    <TextView
                        android:id="@+id/single_class_1_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Đồ họa và hiện thực ảo"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <!-- Dòng 2: Hàng thông tin phụ trợ gom trên ĐÚNG 1 HÀNG DUY NHẤT -->
                    <TextView
                        android:id="@+id/single_class_1_hybrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="P.M-M5.03 • ThS. Nguyễn Văn A"
                        android:textColor="#98989D"
                        android:textSize="9.5sp"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="-0.02"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ca 2: Timeline Row -->
            <LinearLayout
                android:id="@+id/class_item_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <!-- Cột trái: Giờ bắt đầu & Giờ kết thúc -->
                <LinearLayout
                    android:layout_width="46dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="start|center_vertical">

                    <TextView
                        android:id="@+id/single_class_2_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:text="12h45"
                        android:textColor="#1D64F2"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"
                        android:includeFontPadding="false"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/single_class_2_time_end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:text="- 17h05"
                        android:textColor="#98989D"
                        android:textSize="9.5sp"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="-0.02"
                        android:includeFontPadding="false"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Trục Timeline Indicator (Capsule / Line màu Accent) -->
                <ImageView
                    android:id="@+id/single_class_2_indicator"
                    android:layout_width="3dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="10dp"
                    android:background="#1D64F2" />

                <!-- Cột phải: 2 dòng -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Dòng 1: Tên môn học -->
                    <TextView
                        android:id="@+id/single_class_2_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hệ trợ giúp quyết định"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <!-- Dòng 2: Hàng thông tin phụ trợ gom trên ĐÚNG 1 HÀNG DUY NHẤT -->
                    <TextView
                        android:id="@+id/single_class_2_hybrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="P.M-M5.02 • TS. Trần Văn B"
                        android:textColor="#98989D"
                        android:textSize="9.5sp"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="-0.02"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- Spacer co dãn đẩy badge xuống đáy Footer khi có >= 3 ca (RemoteViews safe: dung ImageView) -->
            <ImageView
                android:id="@+id/single_day_spacer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone" />

            <!-- Badge hiển thị khi có >= 3 ca: (+N môn nữa) -->
            <TextView
                android:id="@+id/single_day_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(+1 môn nữa)"
                android:textColor="#1D64F2"
                android:textSize="9sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Empty state when no classes -->
        <TextView
            android:id="@+id/class_empty_message"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Không có ca học nào"
            android:textColor="#98989D"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:visibility="gone" />
    </LinearLayout>
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
