<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC-DYNAMIC-SQLITE-WIDGET-SYSTEM-01: Widget Tuần (4x4, ~320x318 dp) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_card_rounded_20dp"
        android:padding="12dp">

        <!-- 1. Dòng tiêu đề: "Tuần dd/MM – dd/MM" (cỡ 12, vừa) -->
        <LinearLayout
            android:id="@+id/widget_weekly_header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_weekly_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Tuần"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 2. Dải 7 ngày: Hàng nhãn T2..CN (cỡ 11, phụ), Hàng số môn (hoặc ·), Hôm nay viên thuốc accent -->
        <LinearLayout
            android:id="@+id/widget_weekly_strip_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <!-- Col 0: T2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/col_day_label_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T2"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_today_label_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T2"
                    android:textColor="@color/widget_accent"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_count_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_today_count_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:gravity="center"
                    android:background="@drawable/widget_weekly_pill_accent"
                    android:textColor="@color/widget_accent_on"
                    android:textSize="10sp"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Col 1: T3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/col_day_label_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T3"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_today_label_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T3"
                    android:textColor="@color/widget_accent"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_count_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_today_count_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:gravity="center"
                    android:background="@drawable/widget_weekly_pill_accent"
                    android:textColor="@color/widget_accent_on"
                    android:textSize="10sp"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Col 2: T4 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/col_day_label_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T4"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_today_label_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T4"
                    android:textColor="@color/widget_accent"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_count_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_today_count_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:gravity="center"
                    android:background="@drawable/widget_weekly_pill_accent"
                    android:textColor="@color/widget_accent_on"
                    android:textSize="10sp"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Col 3: T5 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/col_day_label_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T5"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_today_label_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T5"
                    android:textColor="@color/widget_accent"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_count_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_today_count_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:gravity="center"
                    android:background="@drawable/widget_weekly_pill_accent"
                    android:textColor="@color/widget_accent_on"
                    android:textSize="10sp"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Col 4: T6 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/col_day_label_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T6"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_today_label_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T6"
                    android:textColor="@color/widget_accent"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_count_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_today_count_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:gravity="center"
                    android:background="@drawable/widget_weekly_pill_accent"
                    android:textColor="@color/widget_accent_on"
                    android:textSize="10sp"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Col 5: T7 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/col_day_label_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T7"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_today_label_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T7"
                    android:textColor="@color/widget_accent"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_count_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_today_count_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:gravity="center"
                    android:background="@drawable/widget_weekly_pill_accent"
                    android:textColor="@color/widget_accent_on"
                    android:textSize="10sp"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Col 6: CN -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/col_day_label_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CN"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_today_label_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CN"
                    android:textColor="@color/widget_accent"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_count_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/col_day_today_count_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:gravity="center"
                    android:background="@drawable/widget_weekly_pill_accent"
                    android:textColor="@color/widget_accent_on"
                    android:textSize="10sp"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Đường kẻ phân cách 0.5dp -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_border" />

        <!-- 3. Danh sách chi tiết cuộn được (ListView) hoặc Empty State -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp">

            <ListView
                android:id="@+id/widget_weekly_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="vertical" />

            <FrameLayout
                android:id="@+id/widget_weekly_empty_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_weekly_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Đăng nhập để xem lịch"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </FrameLayout>
        </FrameLayout>

        <!-- 4. Footer ngày trống cuối tuần khi danh sách không cần cuộn -->
        <TextView
            android:id="@+id/widget_weekly_footer_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:textColor="@color/widget_text_dimmed"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
