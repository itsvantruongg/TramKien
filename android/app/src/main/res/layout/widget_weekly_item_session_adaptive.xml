<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_weekly_item_root"
    android:layout_width="match_parent"
    android:layout_height="28dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/item_color_bar"
        android:layout_width="3.5dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/widget_weekly_bar_rounded" />

    <TextView
        android:id="@+id/item_session_time"
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/widget_text_secondary"
        android:singleLine="true" />

    <TextView
        android:id="@+id/item_session_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="13.5sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/widget_text_primary"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/item_session_room"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/widget_text_secondary"
        android:gravity="end"
        android:singleLine="true" />
</LinearLayout>
