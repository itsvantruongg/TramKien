<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC-DYNAMIC-SQLITE-WIDGET-SYSTEM-01: Widget Hôm nay 2x2 Android Layout -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:background="@android:color/transparent">

    <FrameLayout
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_rounded_20dp">

        <LinearLayout
            android:id="@+id/widget_container_2x2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 1. Nhãn trạng thái (cỡ 11, font vừa 500) -->
            <TextView
                android:id="@+id/widget_status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_accent"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Session Content Area -->
            <LinearLayout
                android:id="@+id/widget_session_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp">

                <!-- 2. Tên môn học (cỡ 13, font vừa 500, tối đa 3 dòng, cắt bằng "…") -->
                <TextView
                    android:id="@+id/widget_subject_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/widget_text_primary"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:includeFontPadding="false" />

                <!-- 3. Dòng thông tin phụ: "HH:mm · phòng" (cỡ 11, màu chữ phụ) -->
                <TextView
                    android:id="@+id/widget_sub_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/widget_text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Empty State Container (Mục 3.6) -->
            <LinearLayout
                android:id="@+id/widget_empty_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_empty_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/widget_text_primary"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_empty_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/widget_text_secondary"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Spacer để đẩy thanh tiến độ và đếm ngược xuống sát đáy -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Bottom Section: Thanh tiến độ & Dòng đếm ngược đáy -->
            <LinearLayout
                android:id="@+id/widget_bottom_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 4. Thanh tiến độ ca học (cao 4dp, bo góc 2dp, sát đáy) -->
                <ProgressBar
                    android:id="@+id/widget_progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:progressDrawable="@drawable/widget_progress_bar_horizontal"
                    android:max="100"
                    android:progress="0"
                    android:visibility="gone" />

                <!-- Thanh tiến độ ca thi (màu đỏ thi) -->
                <ProgressBar
                    android:id="@+id/widget_progress_bar_exam"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:progressDrawable="@drawable/widget_progress_bar_exam_horizontal"
                    android:max="100"
                    android:progress="0"
                    android:visibility="gone" />

                <!-- 5. Dòng đếm ngược đáy: Cỡ 11, màu phụ ("Đến HH:mm") -->
                <TextView
                    android:id="@+id/widget_countdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/widget_text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</FrameLayout>
